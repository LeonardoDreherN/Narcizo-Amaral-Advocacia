# Cabeçalhos aplicados pela Cloudflare Pages.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Os assets do Astro levam hash no nome, então podem ser cacheados para sempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes self-hosted, também com hash.
/_astro/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# O HTML é revalidado a cada visita, para publicações novas aparecerem na hora.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
