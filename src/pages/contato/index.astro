---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import ContactBlock from '~/components/ContactBlock.astro';
import PlaceBlock from '~/components/PlaceBlock.astro';
import { breadcrumbSchema } from '~/lib/schema';

const trail = [{ label: 'Contato' }];
const siteUrl = Astro.site!.origin;
---

<Base
  title="Agendar reunião"
  description="Atendimento presencial em Palhoça ou on-line, para clientes de todo o Brasil. Cada cliente é recebido diretamente por um dos sócios."
  schema={[breadcrumbSchema(siteUrl, [{ label: 'Início', href: '/' }, ...trail])]}
>
  <PageHero
    title="Agende uma reunião"
    lead="Atendimento presencial em Palhoça ou on-line, para clientes de todo o Brasil. Cada cliente é recebido diretamente por um dos sócios."
    trail={trail}
  />

  <ContactBlock />
  <PlaceBlock />
</Base>
