---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { SITE, INDEXAVEL } from '~/data/site';
import { caminhoLimpo } from '~/lib/url';
import '~/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Imagem de compartilhamento já resolvida para URL absoluta. */
  image?: string;
  /** Header já sólido, para páginas que começam com fundo claro. */
  solidHeader?: boolean;
  /** Barra de progresso de leitura, usada nos artigos. */
  progress?: boolean;
  /** Dados estruturados JSON-LD desta página. */
  schema?: unknown[];
  /** Mantém a página fora do índice de busca. */
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  solidHeader = false,
  progress = false,
  schema = [],
  noindex = false,
} = Astro.props;

/** Caminho público, sem a extensão .html que o build acrescenta. */
const path = caminhoLimpo(Astro.url.pathname);

const canonical = new URL(path, Astro.site).href;
const ogImage = image ?? new URL('/og.jpg', Astro.site).href;

/** A home usa o nome do escritório puro; as demais recebem o sufixo. */
const fullTitle = path === '/' ? title : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="pt-BR" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Fora do domínio definitivo, nenhuma página deve ser indexada. */}
    {(noindex || !INDEXAVEL) && <meta name="robots" content="noindex, follow" />}

    <!-- Fontes self-hosted, com preload do que o primeiro paint precisa -->
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />

    <meta name="theme-color" content="#1d2023" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      schema.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} is:inline />
      ))
    }

    <!-- Animações: decide antes do primeiro paint. Se o script não carregar
         em 4 s, tudo volta ao estado estático. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion-js', 'motion-pending');
        try { if (!sessionStorage.getItem('na-seen')) d.classList.add('has-loader'); } catch (e) {}
        setTimeout(function () {
          d.classList.remove('motion-pending', 'has-loader');
          if (!window.__motionReady) {
            // O script demorou ou falhou: o conteudo volta a aparecer pelas
            // regras de reserva. A marca avisa o script, se ele ainda chegar,
            // para nao esconder de novo o que ja esta na tela.
            d.classList.remove('motion-js');
            window.__motionGaveUp = true;
          }
        }, 4000);
      })();
    </script>

    <ClientRouter />
  </head>

  <body>
    {progress && <div class="progress" aria-hidden="true"></div>}

    <div id="loader" aria-hidden="true">
      <div class="ld-mark">
        <div class="ld-name">{SITE.name}</div>
        <div class="ld-sub">{SITE.tagline}</div>
        <div class="ld-bar"><i></i></div>
      </div>
    </div>
    <div id="curtain" aria-hidden="true" transition:persist><span>{SITE.name}</span></div>
    <div class="cursor" id="cursor" aria-hidden="true" transition:persist>Ver perfil</div>
    <div class="float-img" id="float-img" aria-hidden="true" transition:persist><img alt="" /></div>

    <Header solid={solidHeader} />

    <main id="conteudo">
      <slot />
    </main>

    <Footer />

    <script>
      import '~/scripts/motion';
    </script>
  </body>
</html>
