---
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import { dataCurta, dataISO } from '~/lib/format';

interface Props {
  pub: CollectionEntry<'publicacoes'>;
  /**
   * Nível do título do card. Sob uma seção com h2 o padrão 3 está certo; nas
   * listagens, onde os cards vêm logo abaixo do h1, precisa ser 2 para não
   * pular nível.
   */
  nivel?: 2 | 3;
}
const { pub, nivel = 3 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
const area = await getEntry(pub.data.area);
---

<a class="pub" href={`/publicacoes/${pub.id}`} data-stagger-item>
  <div class="pub-img">
    <Image src={pub.data.photo} alt="" width={720} height={480} loading="lazy" />
  </div>
  <div class="pub-meta">
    <b>{area?.data.title}</b>
    <time datetime={dataISO(pub.data.date)}>{dataCurta(pub.data.date)}</time>
  </div>
  <Titulo><span>{pub.data.title}</span></Titulo>
</a>
