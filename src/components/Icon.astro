---
/** Ícones inline. Ficam no HTML para não custar nenhuma requisição. */
interface Props {
  name: 'arrow' | 'chevron';
  class?: string;
}
const { name, class: className } = Astro.props;
---

{
  name === 'arrow' && (
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class={className}>
      <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.2" />
    </svg>
  )
}
{
  name === 'chevron' && (
    <svg viewBox="0 0 12 8" fill="none" aria-hidden="true" class={className}>
      <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.3" />
    </svg>
  )
}
